# Supabase (get from Supabase Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role (backend only: complete-intake entry SMS, sendblue webhook, cron)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Maps / Places (for waitlist city, state autocomplete)
# 1. Create an API key in Google Cloud Console
# 2. Enable "Maps JavaScript API" and "Places API (New)" (required for gmp-place-autocomplete):
#    Places API (New): https://console.developers.google.com/apis/api/places.googleapis.com/overview
# 3. Restrict the key by HTTP referrer in production
# See https://goo.gle/js-api-loading and Places migration: https://developers.google.com/maps/documentation/javascript/places-migration-overview
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# OpenAI (for intake completion embedding: EXPO_PUBLIC_ or OPENAI_API_KEY in .env.local; used by /api/complete-intake)
# EXPO_PUBLIC_OPENAI_API_KEY=sk-...
# OPENAI_API_KEY=sk-...

# Persona (government ID verification: embed on /app/settings/profile; server confirms inquiry)
# Dashboard → Persona → API keys → Secret key (server only)
# PERSONA_API_KEY=
# Inquiry template ID (must start with itmpl_ — NOT vtmpl_ verification templates; those 404 the /widget embed)
# NEXT_PUBLIC_PERSONA_TEMPLATE_ID=itmpl_...
# NEXT_PUBLIC_PERSONA_ENVIRONMENT_ID=env_...
# Optional: force iframe/postMessage origin if it must differ from window.location (e.g. preview URL vs prod allowlist)
# NEXT_PUBLIC_PERSONA_IFRAME_ORIGIN=https://letsfika.vercel.app

# Sendblue (SMS agent: Concierge + Match numbers)
# Required: API key, secret, and Concierge number. Match number is optional (needed only for relay between matched users).
# Optional: webhook secret (set same value in Sendblue dashboard) to verify inbound webhook signatures.
# For reply-only lines (no outbound): set SENDBLUE_REPLY_ONLY=true and add NEXT_PUBLIC_SENDBLUE_CONCIERGE_NUMBER so the app can show "Text FIKA to [number]".
# SENDBLUE_API_KEY_ID=
# SENDBLUE_API_SECRET_KEY=
# SENDBLUE_CONCIERGE_NUMBER=+1234567890
# NEXT_PUBLIC_SENDBLUE_CONCIERGE_NUMBER=+1234567890
# Optional: public JPEG/PNG URL for the concierge contact card (name/photo recipients see). If unset, uses APP_CANONICAL_URL/logo-contact.png.
# SENDBLUE_CONCIERGE_CONTACT_PHOTO_URL=https://letsfika.vercel.app/logo-contact.png
# SENDBLUE_MATCH_NUMBER=+1234567891
# SENDBLUE_WEBHOOK_SECRET=your-webhook-secret
# SENDBLUE_REPLY_ONLY=true
# Optional: public URL override for the phone-signup sample intro MMS (dynamic /api/intro-card). If unset, uses /images/maya-intro-agent.png on APP_CANONICAL_URL with name Maya, age 32.
# SIGNUP_SAMPLE_AVATAR_URL=https://your-cdn.com/jay-sample-headshot.jpg
# Daily cap for messages to users who haven't replied in 24h (default 200; 0 = no cap). Weekly opt-in and follow-up each respect their cap.
# SMS_WEEKLY_OPT_IN_DAILY_CAP=200
# SMS_FOLLOW_UP_DAILY_CAP=200

# Per-user SMS cadence is profiles.sms_intro_mode (weekly_pool | match_first), not an env flag.

# Notion — /thoughts (Blog section; server-only; never NEXT_PUBLIC_)
# Integration: https://www.notion.so/my-integrations → connect integration to the database.
# Database properties must be named exactly:
#   Title (title), Slug (rich_text), Published (checkbox), Date (date), Excerpt (rich_text)
# Slug must be unique per published row; list is sorted by Date descending.
# NOTION_API_KEY=ntn_...
# Optional: database id or full notion.so URL (defaults to Fika conversations DB).
# NOTION_THOUGHTS_DATABASE_ID=331ef446-c136-80ba-baae-f285f633c8c5

# Cron: reminder/onboarding jobs may still use pg_cron; weekly batch jobs are unscheduled (see supabase/migrations).
# Create Vault secrets in Dashboard → Database → Vault: project_url, publishable_key (anon key for Edge Function auth).
# Optional (Vercel): CRON_SECRET for any /api/cron/* routes you keep.
# CRON_SECRET=your-cron-secret

