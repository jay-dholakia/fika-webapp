# Supabase (get from Supabase Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Maps / Places (for waitlist city, state autocomplete)
# Enable Places API and Maps JavaScript API, create an API key, restrict by HTTP referrer in production
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
